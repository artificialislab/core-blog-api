# Artificialis Lab — Blog API (imagem genérica)
# ---------------------------------------------------------------------------
# Esses valores são auto-gerados e injetados no .env do stack do cliente
# pelo platform backend durante o install do serviço "blog". Para dev
# local, copie este arquivo pra .env e preencha.

# Postgres (hostname 'postgres' é alias do container <slug>-postgres na rede)
DATABASE_URL=postgresql://<user>:<password>@postgres:5432/<db_name>

# JWT signing secret (mínimo 32 chars, gerar com: openssl rand -base64 48)
# IMPORTANTE: uma vez que clientes já tenham sessões ativas, NÃO trocar —
# invalida tokens. O platform backend preserva via existingSecrets.
JWT_SECRET=<gerar-com-openssl-rand-base64-48>

# Seed token — usado pelo endpoint POST /admin/seed. Gerado uma vez pelo
# platform backend e guardado no .env. Protege o endpoint de provisioning.
SEED_TOKEN=<gerar-com-openssl-rand-base64-48>

# Porta do container (exposta em 127.0.0.1:PORT pelo compose, atrás do Caddy)
PORT=3001

# Pasta de uploads — volume blog-uploads montado em /uploads
UPLOAD_DIR=/uploads

# Limite de tamanho por upload (bytes). Default 5MB.
UPLOAD_MAX_BYTES=5242880

# Origens permitidas pra CORS. Cliente deve configurar o domínio próprio
# (ex.: https://draalinefranca.com.br ou https://carolinacalegari.com.br).
# Deixar apenas localhost em dev.
CORS_ORIGINS=http://localhost:8080

# Nome do cookie de sessão admin. Default 'blog_admin_session'. Pode ser
# customizado por cliente se quiser segregar (útil em cenários onde
# múltiplos blogs coexistem no mesmo browser profile).
COOKIE_NAME=blog_admin_session

# Cookie seguro deve ficar true em produção HTTPS; deixe false no dev HTTP.
COOKIE_SECURE=false

# Tempo de vida do JWT. Default '30d'. Formatos: '30d', '12h', '3600'.
TOKEN_TTL=30d

# Versão da imagem — preenchido pelo CI ao buildar; mostrado no /health.
BLOG_API_VERSION=dev

# Trust proxy: como o request chega via Caddy (container vizinho no bridge
# network), o default é 1 (confia 1 hop, lê X-Forwarded-For). Override só
# se o setup local precisar de algo diferente:
#   - 'loopback': só confia em 127.0.0.1 (não funciona com Caddy em container)
#   - 'true'    : confia em qualquer proxy (atrás de múltiplos hops)
#   - '2', '3'  : confia em N hops
# TRUST_PROXY=1
