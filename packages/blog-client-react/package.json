{
  "name": "@artificialislab/blog-client-react",
  "version": "0.1.0",
  "description": "Cliente TypeScript canonico do core-blog-api consumido pelos sites Vite/React (Aline, Ana Paula, futuras integracoes). Cookie httpOnly only.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/artificialislab/core-blog-api.git",
    "directory": "packages/blog-client-react"
  }
}
